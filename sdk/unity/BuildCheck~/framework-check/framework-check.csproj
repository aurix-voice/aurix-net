<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Runtime/Client.cs" />
    <Compile Include="../../Runtime/Native.cs" />
    <Compile Include="../../Runtime/Managed/*.cs" />
    <Compile Include="../../Runtime/Unity/*.cs" />
    <Compile Include="../../Runtime/Transports/*.cs" />
    <Compile Include="../../Runtime/Framework/*.cs" />
    <Compile Include="../../Runtime/Framework/Components/*.cs" />
    <Compile Include="../managed-live/Stubs/*.cs" />
  </ItemGroup>
  <!-- weave RPC methods in the built test assembly exactly like Unity's ILPostProcessor would -->
  <Target Name="AurixWeave" AfterTargets="Build" Condition="'$(AurixNoWeave)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../Weaver/Aurix.Net.Weaver.Cli/Aurix.Net.Weaver.Cli.csproj&quot; -c $(Configuration) -- &quot;$(TargetPath)&quot;" />
  </Target>
</Project>
