<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);AURIX_PURRNET;MIRROR;FISHNET</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Runtime/Client.cs" />
    <Compile Include="../../Runtime/Native.cs" />
    <Compile Include="../../Runtime/Managed/*.cs" />
    <Compile Include="../../Runtime/Unity/*.cs" />
    <Compile Include="../../Runtime/Transports/*.cs" />
    <Compile Include="../../Runtime/PurrNet/*.cs" />
    <Compile Include="../../Runtime/Mirror/*.cs" />
    <Compile Include="../../Runtime/FishNet/*.cs" />
    <Compile Include="../managed-live/Stubs/*.cs" />
    <Compile Include="Stubs/*.cs" />
  </ItemGroup>
</Project>
